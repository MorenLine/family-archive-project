{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "files.associations": {
        "*.js": "javascript",
        "*.vue": "vue"
    },
    "emmet.includeLanguages": {
        "javascript": "html"
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    }
}